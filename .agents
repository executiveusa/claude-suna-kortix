{
  "project": "suna-kortix",
  "description": "Suna AI Agent Platform - Secrets specification for Railway zero-secrets deployment",
  "version": "1.0.0",
  "core": {
    "description": "Essential secrets required for basic application functionality",
    "secrets": [
      {
        "name": "SUPABASE_URL",
        "description": "Supabase project URL for database connectivity",
        "format": "https://<project-id>.supabase.co",
        "required": true,
        "placeholder": "https://your-project.supabase.co",
        "category": "database"
      },
      {
        "name": "SUPABASE_ANON_KEY",
        "description": "Supabase anonymous/public API key for client-side access",
        "format": "JWT token string (typically starts with 'eyJ')",
        "required": true,
        "placeholder": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
        "category": "database"
      },
      {
        "name": "SUPABASE_SERVICE_ROLE_KEY",
        "description": "Supabase service role key for server-side admin operations",
        "format": "JWT token string (typically starts with 'eyJ')",
        "required": true,
        "placeholder": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
        "category": "database"
      },
      {
        "name": "SUPABASE_JWT_SECRET",
        "description": "JWT secret for token verification",
        "format": "Base64 encoded string (32+ characters)",
        "required": true,
        "placeholder": "your-super-secret-jwt-token-with-at-least-32-characters-long",
        "category": "database"
      },
      {
        "name": "ENCRYPTION_KEY",
        "description": "Base64 encoded encryption key for sensitive data",
        "format": "Base64 string (32 bytes encoded)",
        "required": true,
        "placeholder": "base64_encoded_32_byte_key",
        "category": "security"
      },
      {
        "name": "KORTIX_ADMIN_API_KEY",
        "description": "Admin API key for Kortix administrative functions",
        "format": "Hex string (64 characters)",
        "required": true,
        "placeholder": "hex_encoded_admin_key",
        "category": "security"
      }
    ]
  },
  "infrastructure": {
    "description": "Infrastructure services configuration",
    "secrets": [
      {
        "name": "REDIS_HOST",
        "description": "Redis server hostname",
        "format": "hostname or IP",
        "required": true,
        "placeholder": "redis",
        "default": "redis",
        "category": "cache"
      },
      {
        "name": "REDIS_PORT",
        "description": "Redis server port",
        "format": "port number",
        "required": true,
        "placeholder": "6379",
        "default": "6379",
        "category": "cache"
      },
      {
        "name": "REDIS_PASSWORD",
        "description": "Redis authentication password",
        "format": "string",
        "required": false,
        "placeholder": "",
        "default": "",
        "category": "cache"
      },
      {
        "name": "REDIS_SSL",
        "description": "Enable SSL for Redis connection",
        "format": "boolean (true/false)",
        "required": false,
        "placeholder": "false",
        "default": "false",
        "category": "cache"
      }
    ]
  },
  "llm_providers": {
    "description": "LLM API keys - at least one provider is required for AI functionality",
    "requirement": "At least one LLM provider is required",
    "secrets": [
      {
        "name": "ANTHROPIC_API_KEY",
        "description": "Anthropic Claude API key (recommended)",
        "format": "sk-ant-...",
        "required": false,
        "placeholder": "sk-ant-api03-...",
        "category": "llm",
        "provider": "Anthropic",
        "signup_url": "https://console.anthropic.com/"
      },
      {
        "name": "OPENAI_API_KEY",
        "description": "OpenAI GPT API key",
        "format": "sk-...",
        "required": false,
        "placeholder": "sk-...",
        "category": "llm",
        "provider": "OpenAI",
        "signup_url": "https://platform.openai.com/"
      },
      {
        "name": "GROQ_API_KEY",
        "description": "Groq API key for fast inference",
        "format": "gsk_...",
        "required": false,
        "placeholder": "gsk_...",
        "category": "llm",
        "provider": "Groq",
        "signup_url": "https://console.groq.com/"
      },
      {
        "name": "OPENROUTER_API_KEY",
        "description": "OpenRouter API key for multiple model access",
        "format": "sk-or-...",
        "required": false,
        "placeholder": "sk-or-...",
        "category": "llm",
        "provider": "OpenRouter",
        "signup_url": "https://openrouter.ai/"
      },
      {
        "name": "GEMINI_API_KEY",
        "description": "Google Gemini API key",
        "format": "AIza...",
        "required": false,
        "placeholder": "AIza...",
        "category": "llm",
        "provider": "Google",
        "signup_url": "https://makersuite.google.com/"
      },
      {
        "name": "XAI_API_KEY",
        "description": "xAI Grok API key",
        "format": "xai-...",
        "required": false,
        "placeholder": "xai-...",
        "category": "llm",
        "provider": "xAI",
        "signup_url": "https://x.ai/"
      },
      {
        "name": "MORPH_API_KEY",
        "description": "Morph API key for fast code editing",
        "format": "string",
        "required": false,
        "placeholder": "",
        "category": "llm",
        "provider": "Morph",
        "signup_url": "https://morphllm.com/"
      },
      {
        "name": "OPENAI_COMPATIBLE_API_KEY",
        "description": "OpenAI-compatible API key",
        "format": "string",
        "required": false,
        "placeholder": "",
        "category": "llm",
        "provider": "Custom"
      },
      {
        "name": "OPENAI_COMPATIBLE_API_BASE",
        "description": "OpenAI-compatible API base URL",
        "format": "https://...",
        "required": false,
        "placeholder": "",
        "category": "llm",
        "provider": "Custom"
      },
      {
        "name": "AWS_ACCESS_KEY_ID",
        "description": "AWS access key for Bedrock",
        "format": "AKIA...",
        "required": false,
        "placeholder": "",
        "category": "llm",
        "provider": "AWS Bedrock"
      },
      {
        "name": "AWS_SECRET_ACCESS_KEY",
        "description": "AWS secret access key for Bedrock",
        "format": "string",
        "required": false,
        "placeholder": "",
        "category": "llm",
        "provider": "AWS Bedrock"
      },
      {
        "name": "AWS_REGION_NAME",
        "description": "AWS region for Bedrock",
        "format": "us-east-1, us-west-2, etc.",
        "required": false,
        "placeholder": "us-east-1",
        "category": "llm",
        "provider": "AWS Bedrock"
      }
    ]
  },
  "search_and_scraping": {
