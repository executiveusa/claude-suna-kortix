        "name": "ENV_MODE",
        "description": "Environment mode",
        "format": "local, staging, or production",
        "required": false,
        "placeholder": "local",
        "default": "local",
        "category": "general"
      }
    ]
  },
  "schema_version": "1.0.0",
  "usage_instructions": {
    "description": "How to use this secrets specification file",
    "steps": [
      "1. Review all required secrets marked with 'required: true'",
      "2. Obtain API keys from respective providers using signup_url links",
      "3. Update master.secrets.json with actual values (never commit this file)",
      "4. For Railway deployment, configure secrets in Railway dashboard",
      "5. For local development, copy values to backend/.env and frontend/.env.local",
      "6. Use placeholder values for testing in non-production environments"
    ],
    "security_notes": [
      "NEVER commit actual secrets to version control",
      "Use environment variables or secure secret management systems",
      "Rotate secrets regularly, especially after team member changes",
      "Use different secrets for development, staging, and production",
      "Monitor secret usage and access logs"
    ]
  }
}
