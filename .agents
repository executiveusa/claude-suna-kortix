  "frontend_config": {
    "description": "Frontend application configuration",
    "secrets": [
      {
        "name": "NEXT_PUBLIC_SUPABASE_URL",
        "description": "Public Supabase URL for frontend",
        "format": "https://<project-id>.supabase.co",
